---
import { DEFAULT_MODEL, switchDistance } from "../model/elevator";
import { projectToShaftPercent, shaftDomain } from "../scripts/elevator-animation";
import Layout from "../layouts/Layout.astro";
import { initialUIState } from "../scripts/elevator-controller";
import { COPY, DISCLAIMER } from "../scripts/elevator-view";

const shaftExtent = shaftDomain(DEFAULT_MODEL);
const targetPercent = projectToShaftPercent(DEFAULT_MODEL.H, shaftExtent);
const carPercent = projectToShaftPercent(0, shaftExtent);
const brakingPercent = projectToShaftPercent(switchDistance(DEFAULT_MODEL, initialUIState.p), shaftExtent);
---

<Layout title={COPY.heading} current="play">
  <main>
    <section aria-labelledby="beginner-heading">
      <div class="play-intro">
        <div class="play-intro-copy">
          <h1 id="beginner-heading">{COPY.heading}</h1>
          <p data-testid="task">{COPY.task}</p>
        </div>
        <div data-testid="see-why-link-host" class="play-intro-cta" hidden>
          <a href="principle.html" data-testid="see-why-link" class="comic-button see-why-link">SEE WHY IT WORKS</a>
        </div>
      </div>
      <div data-testid="elevator-app">
        <section data-testid="predicting" class="panel">
          <div class="shaft-col">
            <div data-testid="shaft" class="shaft">
              <div data-testid="target-marker" class="marker marker-target" style={`bottom: ${targetPercent}%;`}>
              </div>
              <div data-testid="braking-marker" class="marker marker-braking" style={`bottom: ${brakingPercent}%;`}>
              </div>
              <div data-testid="car" class="car" style={`bottom: ${carPercent}%;`}></div>
            </div>
          </div>
          <div class="content-col">
            <label for="percentage-input">{COPY.sliderLabel}</label>
            <input
              id="percentage-input"
              data-testid="percentage-input"
              type="range"
              min="1"
              max="100"
              step="1"
              value={initialUIState.p}
            />
            <span data-testid="percentage-value">{initialUIState.p}%</span>
            <button type="button" data-testid="run-button" class="comic-button">{COPY.runButton}</button>
            <div data-testid="hint">
              <button type="button" data-testid="hint-button" class="comic-button">{COPY.hintButton}</button>
            </div>
          </div>
        </section>
      </div>
      <p data-testid="disclaimer">{DISCLAIMER}</p>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
