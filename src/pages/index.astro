---
import Layout from "../layouts/Layout.astro";
---

<Layout title="How late can you brake?" current="home">
  <main>
    <section class="hero" aria-label="Introduction">
      <div class="hero-art" aria-hidden="true">
        <div class="hero-floor-line hero-floor-line-1"></div>
        <div class="hero-floor-line hero-floor-line-2"></div>
        <div class="hero-floor-line hero-floor-line-3"></div>
        <div class="hero-cargo"></div>
        <div class="hero-car">
          <span class="hero-car-cable"></span>
        </div>
      </div>
      <p class="hero-eyebrow">AN ELEVATOR. ONE TARGET. NO TIME TO WASTE.</p>
      <h1 class="hero-heading">HOW LATE CAN YOU BRAKE?</h1>
      <p class="hero-body">Getting to the floor is easy. Arriving completely stopped is the puzzle.</p>
      <div class="hero-cta-group">
        <a href="play.html" class="comic-button hero-cta">TAKE THE ELEVATOR</a>
        <a href="principle.html" class="comic-button hero-cta hero-cta-secondary">LEARN WHY</a>
      </div>
    </section>
  </main>
</Layout>
