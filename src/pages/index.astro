---
import Layout from "../layouts/Layout.astro";
import { initialUIState } from "../scripts/elevator-controller";
import { COPY, DISCLAIMER } from "../scripts/elevator-view";
---

<Layout title={COPY.heading}>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>{COPY.heading}</h1>
    <p data-testid="task">{COPY.task}</p>
    <div data-testid="elevator-app">
      <section data-testid="predicting">
        <label for="percentage-input">{COPY.sliderLabel}</label>
        <input
          id="percentage-input"
          data-testid="percentage-input"
          type="range"
          min="1"
          max="100"
          step="1"
          value={initialUIState.p}
        />
        <span data-testid="percentage-value">{initialUIState.p}%</span>
        <button type="button" data-testid="run-button">{COPY.runButton}</button>
      </section>
    </div>
    <p data-testid="disclaimer">{DISCLAIMER}</p>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
