---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  current: "home" | "play" | "principle";
}

const { title, current } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='2' y='2' width='28' height='28' rx='3' fill='%23fff' stroke='%23000' stroke-width='2.5'/%3E%3Crect x='12' y='9' width='8' height='6' fill='%23fff' stroke='%23000' stroke-width='2'/%3E%3Cpath d='M16 3v6M12 21h8l-2 5h-4z' fill='%23000'/%3E%3C/svg%3E"
    />

  </head>
  <body>
    <SiteHeader current={current} />
    <slot />
  </body>
</html>
